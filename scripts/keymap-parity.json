  "divergences": [
    {
      "pi": "tui.editor.deleteToLineStart",
      "reason": "Pi 的 Ctrl+u 删到行首，nini 清空输入框——nini 里有 KillToLineStart 动作但**没有绑定**，改键即可对齐"
    },
    {
      "pi": "app.clear",
      "reason": "Pi 的 Ctrl+c 先清空输入框再退出，nini 的 Ctrl+c 中止回合；nini 的 Quit 走 Ctrl+D（与 Pi 一致）"
    },
    {
      "pi": "app.thinking.toggle",
      "reason": "Pi 的 Ctrl+t 显隐 thinking 块，nini 的 Ctrl+t 提高 thinking 档位——nini 没有「显隐 thinking 块」这个动作"
    }
  ],
  "exempt": [
    {
      "glob": "app.session.*",
      "reason": "nini 的会话操作走斜杠命令（/new、/resume、/tree、/rename），没有 Pi 那套会话键位"
    },
    {
      "glob": "app.models.*",
      "reason": "nini 的模型管理是 /model 选择器 + Ctrl+P 循环，没有 Pi 的批量 enable/reorder/save"
    },
    {
      "glob": "app.tree.*",
      "reason": "nini 没有 Pi 的 tree 视图（台账 B5：double-ESC 不切 tree）"
    },
    {
      "glob": "app.thinking.save",
      "reason": "nini 的 thinking 档位存在 settings.json，不需要一个「保存」键"
    },
    {
      "glob": "tui.altScreen.searchNext",
      "reason": "nini 的搜索在搜索栏内用 Enter/Shift+Enter 上下移动，没有独立的键位 id"
    },
    {
      "glob": "tui.altScreen.searchPrevious",
      "reason": "同上"
    },
    {
      "glob": "tui.altScreen.previousPrompt",
      "reason": "nini 没有「跳到上一个语义提示」"
    },
    {
      "glob": "tui.altScreen.nextPrompt",
      "reason": "nini 没有「跳到下一个语义提示」"
    },
    {
      "glob": "tui.select.*",
      "reason": "nini 的浮层用 Enter/Esc 走统一路径（handle_selector_key），没有 Pi 那套 select.* 键位 id"
    }
  ]
}
